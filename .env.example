# ─── قاعدة البيانات ─────────────────────────────────────────────
# التطوير المحلي (SQLite):
DATABASE_URL="file:./prisma/data.db"

# الإنتاج (PostgreSQL — مثال Aiven Free):
# DATABASE_URL="postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require&connection_limit=5"
#
# عند تغيير الرابط إلى postgres يتعرف المشروع تلقائيًا على النوع،
# ويولّد عميل Prisma من prisma/postgres/schema.prisma بدل نسخة SQLite.

# ─── الأسرار ────────────────────────────────────────────────────
# مفتاح تشفير اعتمادات OAuth مخزنة (AES-256-GCM):  openssl rand -hex 32
APP_ENCRYPTION_KEY=

# سرّ توقيع كوكي الجلسة:  openssl rand -hex 32
SESSION_SECRET=

# ─── تطبيق Kick ────────────────────────────────────────────────
# أنشئ تطبيقًا من بوابة مطوّري Kick — راجع الخطوات الحالية من documentation الرسمي (docs.kick.com)
# الروابط التي تُسجَّل في إعدادات التطبيق:
#   Redirect URI:      {APP_BASE_URL}/api/kick/callback
#   Webhook Endpoint:  {APP_BASE_URL}/api/kick/webhook
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ─── عنوان التطبيق العام ───────────────────────────────────────
APP_BASE_URL="http://localhost:3000"

# ─── اختياري: رابط رجوع Kick ───────────────────────────────────
# إن ضُبط، يُستخدم بدل المشتق من APP_BASE_URL — ويجب أن يطابق رابط
# (Redirect URI) المسجَّل في تطبيق Kick حرفيًا (بلا شرطة إضافية/مسافة/فرق منفذ).
# KICK_REDIRECT_URI="http://localhost:3000/api/kick/callback"
